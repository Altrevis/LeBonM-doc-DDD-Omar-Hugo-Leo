{
  "info": {
    "name": "LeBonMédoc - Tests API",
    "description": "Lancer l'API (npm start), puis exécuter la collection dans l'ordre : la requête 1 charge le jeu de données.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Charger le jeu de données",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/seed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "seed"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"6 pharmacies, 12 médicaments, 13 présentations, 15 utilisateurs, 10 réservations et 10 lignes\", () => {",
              "pm.expect(b.pharmacies).to.eql(6); pm.expect(b.medicaments).to.eql(12); pm.expect(b.presentations).to.eql(13); pm.expect(b.utilisateurs).to.eql(15); pm.expect(b.reservations).to.eql(10); pm.expect(b.lignesReservation).to.eql(10); });",
              "Object.entries(b.idsReservations).forEach(([k, id]) => pm.collectionVariables.set(k, id));",
              "pm.test(\"identifiants r1..r10 enregistrés\", () => pm.expect(pm.collectionVariables.get(\"r10\")).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Rechercher un médicament",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/disponibilites?nom=doliprane",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "disponibilites"
          ],
          "query": [
            {
              "key": "nom",
              "value": "doliprane"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"3 résultat(s)\", () => pm.expect(pm.response.json().length).to.eql(3));",
              "{ const d = pm.response.json().find(x => x.pharmacie.id === \"ph-centre\" && x.presentation.id === \"pre-doliprane500\");",
              "pm.test(\"ph-centre / doliprane500 : 40 disponible(s)\", () => pm.expect(d && d.disponible).to.eql(40)); }",
              "{ const d = pm.response.json().find(x => x.pharmacie.id === \"ph-centre\" && x.presentation.id === \"pre-doliprane1000\");",
              "pm.test(\"ph-centre / doliprane1000 : 25 disponible(s)\", () => pm.expect(d && d.disponible).to.eql(25)); }",
              "{ const d = pm.response.json().find(x => x.pharmacie.id === \"ph-croix\" && x.presentation.id === \"pre-doliprane1000\");",
              "pm.test(\"ph-croix / doliprane1000 : 30 disponible(s)\", () => pm.expect(d && d.disponible).to.eql(30)); }",
              "{ const d = pm.response.json().find(x => x.pharmacie.id === \"ph-gare\" && x.presentation.id === \"pre-doliprane500\");",
              "pm.test(\"ph-gare / doliprane500 : absent des résultats\", () => pm.expect(d && d.disponible).to.eql(undefined)); }",
              "{ const d = pm.response.json().find(x => x.pharmacie.id === \"ph-tetedor\" && x.presentation.id === \"pre-doliprane500\");",
              "pm.test(\"ph-tetedor / doliprane500 : absent des résultats\", () => pm.expect(d && d.disponible).to.eql(undefined)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consulter une réservation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{r3}}?clientId=usr-chloe",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "{{r3}}"
          ],
          "query": [
            {
              "key": "clientId",
              "value": "usr-chloe"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"statut = retiree\", () => pm.expect(pm.response.json().statut).to.eql(\"retiree\"));",
              "pm.test(\"ligne de réservation conservée\", () => pm.expect(pm.response.json().lignes[0].presentationId).to.eql(\"pre-efferalgan\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Définir le stock d'une pharmacie",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pharmacies/{{phCentre}}/stocks/{{preSpasfon}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pharmacies",
            "{{phCentre}}",
            "stocks",
            "{{preSpasfon}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantiteBase\": 10,\n  \"pharmacienId\": \"usr-ph-centre\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"10 disponibles\", () => pm.expect(pm.response.json().disponible).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Accepter une réservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{r1}}/accepter",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "{{r1}}",
            "accepter"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pharmacienId\": \"usr-ph-centre\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"statut = acceptee\", () => pm.expect(pm.response.json().statut).to.eql(\"acceptee\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Accepter une 2e fois (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{r1}}/accepter",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "{{r1}}",
            "accepter"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pharmacienId\": \"usr-ph-centre\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Erreur OperationDejaEffectueeError\", () => pm.expect(pm.response.json().erreur.type).to.eql(\"OperationDejaEffectueeError\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Demander une réservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"usr-zoe\",\n  \"pharmacieId\": \"{{phCentre}}\",\n  \"lignes\": [{ \"presentationId\": \"{{preSpasfon}}\", \"quantite\": 1, \"unite\": \"unite\" }]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"statut = en_attente\", () => pm.expect(pm.response.json().statut).to.eql(\"en_attente\"));",
              "pm.collectionVariables.set(\"rZoe\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Demande invalide : quantité 0 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"usr-zoe\",\n  \"pharmacieId\": \"{{phCentre}}\",\n  \"lignes\": [{ \"presentationId\": \"{{preIbuprofene}}\", \"quantite\": 0, \"unite\": \"unite\" }]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Erreur DemandeInvalideError\", () => pm.expect(pm.response.json().erreur.type).to.eql(\"DemandeInvalideError\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Stock insuffisant (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"usr-zoe\",\n  \"pharmacieId\": \"{{phCentre}}\",\n  \"lignes\": [{ \"presentationId\": \"{{preIbuprofene}}\", \"quantite\": 19, \"unite\": \"unite\" }]\n}",
          "options": {
            "raw": {
              "language": "json"

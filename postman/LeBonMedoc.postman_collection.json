            ]
          }
        }
      ]
    },
    {
      "name": "10. Retirer une réservation refusée (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{r5}}/retirer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "{{r5}}",
            "retirer"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pharmacienId\": \"usr-ph-gare\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Erreur TransitionInterditeError\", () => pm.expect(pm.response.json().erreur.type).to.eql(\"TransitionInterditeError\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Réservation expirée (410)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{r6}}/retirer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "{{r6}}",
            "retirer"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pharmacienId\": \"usr-ph-croix\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Simule 25 h de plus : la réservation r6 (acceptée) est alors périmée.",
              "pm.sendRequest({",
              "  url: pm.variables.replaceIn(\"{{baseUrl}}/admin/horloge\"),",
              "  method: \"POST\",",
              "  header: { \"Content-Type\": \"application/json\" },",
              "  body: { mode: \"raw\", raw: JSON.stringify({ avancerHeures: 25 }) }",
              "}, (err) => { if (err) throw err; });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 410\", () => pm.response.to.have.status(410));",
              "pm.test(\"Erreur ReservationExpireeError\", () => pm.expect(pm.response.json().erreur.type).to.eql(\"ReservationExpireeError\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Réservation inconnue (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
